  "installCommand": "",
  "buildCommand": "bash tool/vercel/build-dashboard.sh",
  "outputDirectory": "apps/dashboard/build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
